export const TextInput = ({ label, name, type = 'text', placeholder, iconClass, register, rules, error, onBlurTrigger }) => {
  return (
    <div>
      {label && <label className="block text-sm font-semibold text-white/90 mb-1" htmlFor={name}>{label}</label>}
      <div className="relative">
        {iconClass && (
          <div className="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
            <i className={`${iconClass} text-white/40`}></i>
          </div>
        )}
        <input
          id={name}
          type={type}
          placeholder={placeholder}
          className={`appearance-none block w-full ${iconClass ? 'pl-10' : 'pl-4'} pr-4 py-3 
            bg-white/10 backdrop-blur-sm border border-white/20 
            text-white placeholder-white/40
            rounded-xl
            focus:ring-2 focus:ring-pink-400/50 focus:border-pink-400/50 focus:bg-white/15
            hover:border-white/30 hover:bg-white/15
            transition-all duration-300`}
          {...register(name, rules)}
          onBlur={() => onBlurTrigger && onBlurTrigger(name)}
        />
        {error && <p className="absolute -bottom-5 inset-x-0 text-pink-300 text-xs font-medium">{error.message}</p>}
      </div>
    </div>
  );
};

export default TextInput;
